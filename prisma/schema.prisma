generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique // null pour un joueur invité (auth progressive)
  passwordHash String? // null pour un joueur invité
  isGuest      Boolean  @default(false)
  displayName  String
  avatarEmoji  String   @default("🙂")
  bio          String?
  birthdate    DateTime?
  createdAt    DateTime @default(now())

  duoMemberships DuoMember[]
  answers        Answer[]
  reactions      Reaction[]
  discussions    Discussion[]
}

model Duo {
  id        String   @id @default(cuid())
  code      String   @unique // lien d'invitation /join/[CODE]
  status    String   @default("pending") // pending | ready
  createdAt DateTime @default(now())

  members  DuoMember[]
  sessions GameSession[]
}

model DuoMember {
  id       String   @id @default(cuid())
  duoId    String
  duo      Duo      @relation(fields: [duoId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // host | partner
  joinedAt DateTime @default(now())

  @@unique([duoId, userId])
  @@index([userId])
}

model GameSession {
  id        String   @id @default(cuid())
  status    String   @default("playing") // lobby | playing | completed
  currentLevel Int   @default(1)
  maxRounds Int      @default(6) // §13 : session courte de 5 à 7 cartes
  turnUserId   String? // qui doit tirer la prochaine carte
  createdAt DateTime @default(now())

  duoId    String
  duo      Duo    @relation(fields: [duoId], references: [id], onDelete: Cascade)

  rounds    Round[]
}

model Question {
  id       String   @id @default(cuid())
  level    Int
  text     String
  options  String[]
  category String?

  rounds   Round[]
}

model Round {
  id         String   @id @default(cuid())
  sessionId  String
  session    GameSession @relation(fields: [sessionId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  level      Int
  status     String   @default("pending") // pending | revealed
  matched    Boolean?
  startedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  answers    Answer[]
  reactions  Reaction[]
  discussions Discussion[]

  @@index([sessionId])
}

model Answer {
  id        String   @id @default(cuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  choice    String
  createdAt DateTime @default(now())

  @@unique([roundId, userId])
}

/** Réaction rapide après une révélation (§19). Une par joueur et par manche. */
model Reaction {
  id        String   @id @default(cuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([roundId, userId])
  @@index([roundId])
}

/**
 * Conversation ouverte après une divergence (§20) : l'action choisie
 * (pourquoi / défendre / compromis) et, pour « pourquoi », la motivation
 * sélectionnée (§21). Une par joueur et par manche.
 */
model Discussion {
  id        String   @id @default(cuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String?
  createdAt DateTime @default(now())

  @@unique([roundId, userId])
  @@index([roundId])
}
