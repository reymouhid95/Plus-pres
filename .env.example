# Connexion Neon (récupérée depuis le dashboard Neon > Connection Details)
# Utilisez l'URL "pooled" pour DATABASE_URL et l'URL directe pour DIRECT_URL (migrations)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/plus_pres?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/plus_pres?sslmode=require"

# Générez avec: openssl rand -base64 32
NEXTAUTH_SECRET="changez-moi"
NEXTAUTH_URL="http://localhost:3000"
